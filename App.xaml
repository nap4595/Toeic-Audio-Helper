<Application x:Class="ToeicAudioHelper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ToeicAudioHelper"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/UiKit.Wpf;component/Themes/BaseStyles.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/UiKit.Wpf;component/Themes/Theme.Dark.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- App-specific accent override: strong orange -->
      <SolidColorBrush x:Key="Brush.Accent" Color="#F97316"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>


