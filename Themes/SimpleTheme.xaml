<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Minimal palette -->
  <SolidColorBrush x:Key="Brush.Frame" Color="#1F3AF5"/>
  <SolidColorBrush x:Key="Brush.TopBar" Color="#EDEBFF"/>
  <SolidColorBrush x:Key="Brush.Canvas" Color="#FFF7E6"/>
  <SolidColorBrush x:Key="Brush.Text" Color="#161C2D"/>
  <SolidColorBrush x:Key="Brush.Muted" Color="#6B7280"/>
  <SolidColorBrush x:Key="Brush.Primary" Color="#2D5BFF"/>

  <!-- Base typography -->
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
  </Style>

  <!-- Low-round rectangle buttons -->
  <Style TargetType="Button">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#DDE3EA"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#C8D1DC"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#F4F6F8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#DDE3EA"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#DDE3EA"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,2"/>
  </Style>

  <!-- Shell container and top bar -->
  <Style x:Key="Shell" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Canvas}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Frame}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="14"/>
  </Style>
  <Style x:Key="TopBar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.TopBar}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="CornerRadius" Value="12,12,0,0"/>
    <Setter Property="BorderBrush" Value="#D9D6FF"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

</ResourceDictionary>

