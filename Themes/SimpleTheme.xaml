<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Terminal-like dark palette -->
  <SolidColorBrush x:Key="Brush.Frame" Color="#2A2A2A"/>
  <SolidColorBrush x:Key="Brush.TopBar" Color="#0C0C0C"/>
  <SolidColorBrush x:Key="Brush.Canvas" Color="#0C0C0C"/>
  <SolidColorBrush x:Key="Brush.Text" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="Brush.Muted" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="Brush.Primary" Color="#16C1D9"/>

  <!-- Base typography -->
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, 'Courier New', monospace"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
  </Style>

  <!-- ToggleButton (dark): clearer border/checked accent -->
  <Style TargetType="ToggleButton">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Background" Value="#141414"/>
    <Setter Property="BorderBrush" Value="#3A3A3A"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1F1F1F"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#4A4A4A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2E2E2E"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#111111"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
              <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- RepeatButton styled like Button (dark) -->
  <Style TargetType="RepeatButton">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Background" Value="#1A1A1A"/>
    <Setter Property="BorderBrush" Value="#2A2A2A"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#232323"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#3A3A3A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2E2E2E"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Square-corner buttons (dark) -->
  <Style TargetType="Button">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Background" Value="#1A1A1A"/>
    <Setter Property="BorderBrush" Value="#2A2A2A"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#232323"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#3A3A3A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2E2E2E"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#111111"/>
    <Setter Property="BorderBrush" Value="#2A2A2A"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
  </Style>
  
  <!-- ToggleButton styled like Button -->
  
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="#111111"/>
    <Setter Property="BorderBrush" Value="#2A2A2A"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Grid Margin="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="22"/>
              </Grid.ColumnDefinitions>
              <!-- Invisible toggle overlay to open/close dropdown -->
              <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                            Background="#00000000" BorderBrush="{x:Null}" BorderThickness="0"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
              <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
              <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,0,0">
                <TextBlock Text="▾" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
            </Grid>
            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
              <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border Background="#111111" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A3A"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111111"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#111111"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#111111"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E5E5E5"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E5E5E5"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#232323"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E5E5E5"/>
    </Style.Resources>
  </Style>

  <!-- ComboBoxItem: dark dropdown rows -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Background" Value="#111111"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="BorderBrush" Value="#2A2A2A"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Margin="4,0,4,0" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1A1A1A"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#232323"/>
              <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Shell container and top bar -->
  <Style x:Key="Shell" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Canvas}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Frame}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="TopBar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.TopBar}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="CornerRadius" Value="8,8,0,0"/>
    <Setter Property="BorderBrush" Value="#2A2A2A"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <!-- Slider: terminal-like track and thumb (horizontal) -->
  <Style TargetType="Slider">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Margin="0,4,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Track x:Name="PART_Track" Height="4">
              <Track.DecreaseRepeatButton>
                <!-- Remove progress fill: use same dark color as rest of track -->
                <RepeatButton Command="Slider.DecreaseLarge" Background="#2A2A2A" BorderBrush="#2A2A2A" Height="4"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Height="12" Width="12">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{StaticResource Brush.Primary}" CornerRadius="2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Background="#2A2A2A" BorderBrush="#2A2A2A" Height="4"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
