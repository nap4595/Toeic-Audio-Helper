<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark theme palette -->
  <SolidColorBrush x:Key="Brush.Canvas" Color="#3c4856"/>
  <SolidColorBrush x:Key="Brush.TopBar" Color="#344353"/>
  <SolidColorBrush x:Key="Brush.Frame" Color="#a0acbd"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="#3a96dd"/>
  <SolidColorBrush x:Key="Brush.Text" Color="#EEF3F8"/>
  <SolidColorBrush x:Key="Brush.Muted" Color="#C1CAD6"/>

  <!-- Controls -->
  <SolidColorBrush x:Key="Brush.ControlBg" Color="#2f3b49"/>
  <SolidColorBrush x:Key="Brush.ControlBorder" Color="#a0acbd"/>
  <SolidColorBrush x:Key="Brush.ControlHoverBg" Color="#364451"/>
  <SolidColorBrush x:Key="Brush.ControlHoverBorder" Color="#b8c3d1"/>
  <SolidColorBrush x:Key="Brush.ControlPressedBg" Color="#2a3643"/>
  <SolidColorBrush x:Key="Brush.TrackBg" Color="#2a3541"/>
</ResourceDictionary>

