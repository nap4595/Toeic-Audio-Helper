<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark theme palette -->
  <SolidColorBrush x:Key="Brush.Canvas" Color="#222b35"/>
  <SolidColorBrush x:Key="Brush.TopBar" Color="#1e2732"/>
  <SolidColorBrush x:Key="Brush.Frame" Color="#a0acbd"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="#d77757"/>
  <SolidColorBrush x:Key="Brush.Text" Color="#E9EEF3"/>
  <SolidColorBrush x:Key="Brush.Muted" Color="#B8C3D1"/>

  <!-- Controls -->
  <SolidColorBrush x:Key="Brush.ControlBg" Color="#1c2430"/>
  <SolidColorBrush x:Key="Brush.ControlBorder" Color="#a0acbd"/>
  <SolidColorBrush x:Key="Brush.ControlHoverBg" Color="#273242"/>
  <SolidColorBrush x:Key="Brush.ControlHoverBorder" Color="#b8c3d1"/>
  <SolidColorBrush x:Key="Brush.ControlPressedBg" Color="#18202a"/>
  <SolidColorBrush x:Key="Brush.TrackBg" Color="#161e27"/>
</ResourceDictionary>
