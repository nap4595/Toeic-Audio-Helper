<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme palette -->
  <SolidColorBrush x:Key="Brush.Canvas" Color="#fff6f1"/>
  <SolidColorBrush x:Key="Brush.TopBar" Color="#fff1e9"/>
  <SolidColorBrush x:Key="Brush.Frame" Color="#b98473"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="#d77757"/>
  <SolidColorBrush x:Key="Brush.Text" Color="#3b3b3b"/>
  <SolidColorBrush x:Key="Brush.Muted" Color="#7a5c52"/>

  <!-- Controls -->
  <SolidColorBrush x:Key="Brush.ControlBg" Color="#ffffff"/>
  <SolidColorBrush x:Key="Brush.ControlBorder" Color="#b98473"/>
  <SolidColorBrush x:Key="Brush.ControlHoverBg" Color="#fff3ea"/>
  <SolidColorBrush x:Key="Brush.ControlHoverBorder" Color="#c89a88"/>
  <SolidColorBrush x:Key="Brush.ControlPressedBg" Color="#f5e7df"/>
  <SolidColorBrush x:Key="Brush.TrackBg" Color="#e9ddd6"/>
</ResourceDictionary>

