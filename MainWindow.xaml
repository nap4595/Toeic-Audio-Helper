<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ToeicAudioHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:UiKit="clr-namespace:UiKit.Wpf.Controls;assembly=UiKit.Wpf"
        Title="TOEIC Audio Helper" Height="300" Width="520"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        KeyDown="Window_KeyDown" Focusable="True">
    <Window.Resources>
                <Style x:Key="StrongRepeatToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Checked: force accent fill and text regardless of hover/press -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.SelectionText}"/>
                            </Trigger>
                            <!-- Hover only when not checked -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHoverBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.ControlHoverBorder}"/>
                            </MultiTrigger>
                            <!-- Pressed only when not checked -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlPressedBg}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Shell}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <UiKit:TopBar Grid.Row="0" Title="TOEIC Audio Helper" ButtonSize="22"/>

            <Grid Grid.Row="1" Margin="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <Button x:Name="BtnSelectFolder" Click="BtnSelectFolder_Click">Select Folder</Button>
                    <Button x:Name="BtnRescan" Click="BtnRescan_Click" Margin="6,0,0,0">Rescan</Button>
                    <TextBox x:Name="TxtRoot" IsReadOnly="True" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Text="Test"/>
                    <ComboBox Grid.Column="1" x:Name="CmbTest" SelectedIndex="0" VerticalAlignment="Center" MinWidth="100">
                        <ComboBoxItem Content="01"/><ComboBoxItem Content="02"/><ComboBoxItem Content="03"/><ComboBoxItem Content="04"/><ComboBoxItem Content="05"/>
                        <ComboBoxItem Content="06"/><ComboBoxItem Content="07"/><ComboBoxItem Content="08"/><ComboBoxItem Content="09"/><ComboBoxItem Content="10"/>
                    </ComboBox>
                    <Button Grid.Column="2" x:Name="BtnPlayAll" Click="BtnPlayAll_Click" Margin="8,0,0,0">LOAD</Button>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0,6,0" Text="Question"/>
                    <Grid Grid.Column="4" Width="120">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtQuestion" Grid.Column="0" PreviewTextInput="TxtQuestion_PreviewTextInput" MaxLength="3" VerticalContentAlignment="Center" TextAlignment="Center" LostFocus="TxtQuestion_LostFocus" KeyDown="TxtQuestion_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                            <RepeatButton x:Name="BtnQUp" Click="BtnQUp_Click" Width="24" Height="16" Padding="0" Margin="4,0,0,0" Delay="300" Interval="80"  Style="{StaticResource IconGlyphRepeatButton}">&#xE70E;</RepeatButton>
                            <RepeatButton x:Name="BtnQDown" Click="BtnQDown_Click" Width="24" Height="16" Padding="0" Margin="4,4,0,0" Delay="300" Interval="80"  Style="{StaticResource IconGlyphRepeatButton}">&#xE70D;</RepeatButton>
                        </StackPanel>
                    </Grid>
                    <Button Grid.Column="5" x:Name="BtnPlayPart" Click="BtnPlayPart_Click" Margin="8,0,0,0">LOAD</Button>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblNow" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">00:00</TextBlock>
                        <Slider x:Name="SldPosition" Grid.Column="1" Minimum="0" ValueChanged="SldPosition_ValueChanged" PreviewMouseDown="SldPosition_PreviewMouseDown" PreviewMouseUp="SldPosition_PreviewMouseUp"/>
                        <TextBlock x:Name="LblTotal" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">00:00</TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Button x:Name="BtnSeekBack" Click="BtnSeekBack_Click" ToolTip="5s Back" Style="{StaticResource IconGlyphButton}" Margin="6,0,6,0">&#xE892;</Button>
                        <Button x:Name="BtnPlayPause" Click="BtnPlayPause_Click" Style="{StaticResource IconGlyphButton}" Margin="6,0,6,0">&#xE768;</Button>
                        <Button x:Name="BtnStop" Click="BtnStop_Click" Style="{StaticResource IconGlyphButton}" Margin="6,0,6,0">&#xE71A;</Button>
                        <Button x:Name="BtnSeekForward" Click="BtnSeekForward_Click" ToolTip="5s Forward" Style="{StaticResource IconGlyphButton}" Margin="6,0,6,0">&#xE893;</Button>
                    </StackPanel>
                    <DockPanel Margin="0,8,0,0">
                        <ToggleButton x:Name="TglRepeat" DockPanel.Dock="Left" ToolTip="Repeat" Checked="TglRepeat_Checked" Unchecked="TglRepeat_Unchecked" Style="{StaticResource StrongRepeatToggle}" Margin="0,0,12,0">R</ToggleButton>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="BtnPlayVocaLc" Click="BtnPlayVocaLc_Click">VOCA LC</Button>
                            <Button x:Name="BtnPlayVocaRc" Click="BtnPlayVocaRc_Click" Margin="0,0,12,0">VOCA RC</Button>
                            <ToggleButton x:Name="TglMode" ToolTip="Toggle between Full Test and Question mode" Checked="TglMode_Checked" Unchecked="TglMode_Unchecked" Style="{StaticResource StrongRepeatToggle}">Full Test</ToggleButton>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Muted}"/>
                    <TextBlock x:Name="TxtNowPlaying" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>











