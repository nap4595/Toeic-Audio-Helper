<Window x:Class="ToeicAudioHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToeicAudioHelper"
        mc:Ignorable="d"
        Title="TOEIC Audio Helper"
        Height="300" Width="520"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True">
    <Border Style="{StaticResource Shell}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Simple Top Bar -->
            <Border Grid.Row="0" Style="{StaticResource TopBar}" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="TOEIC Audio Helper" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="BtnMin" Click="BtnMin_Click" Width="22" Height="22" Margin="4,0">−</Button>
                        <Button x:Name="BtnMax" Click="BtnMax_Click" Width="22" Height="22" Margin="4,0">▢</Button>
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Width="22" Height="22" Margin="4,0">✕</Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <Button x:Name="BtnSelectFolder" Click="BtnSelectFolder_Click">Select Folder</Button>
                    <Button x:Name="BtnRescan" Click="BtnRescan_Click" Margin="6,0,0,0">Rescan</Button>
                    <TextBox x:Name="TxtRoot" IsReadOnly="True" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                </DockPanel>

                <!-- Controls Row -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left: Test, Play All, Question, Play Part -->
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Text="Test"/>
                    <ComboBox Grid.Column="1" x:Name="CmbTest" SelectedIndex="0" VerticalAlignment="Center" MinWidth="100">
                        <ComboBoxItem Content="01"/>
                        <ComboBoxItem Content="02"/>
                        <ComboBoxItem Content="03"/>
                        <ComboBoxItem Content="04"/>
                        <ComboBoxItem Content="05"/>
                        <ComboBoxItem Content="06"/>
                        <ComboBoxItem Content="07"/>
                        <ComboBoxItem Content="08"/>
                        <ComboBoxItem Content="09"/>
                        <ComboBoxItem Content="10"/>
                    </ComboBox>
                    <Button Grid.Column="2" x:Name="BtnPlayAll" Click="BtnPlayAll_Click" Margin="8,0,0,0">Play All</Button>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0,6,0" Text="Question"/>
                    <Grid Grid.Column="4" Width="120">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtQuestion" Grid.Column="0" PreviewTextInput="TxtQuestion_PreviewTextInput" MaxLength="3" VerticalContentAlignment="Center" TextAlignment="Center" LostFocus="TxtQuestion_LostFocus" KeyDown="TxtQuestion_KeyDown"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                            <RepeatButton x:Name="BtnQUp" Click="BtnQUp_Click" Width="24" Height="16" Padding="0" Margin="4,0,0,0" Delay="300" Interval="80">▲</RepeatButton>
                            <RepeatButton x:Name="BtnQDown" Click="BtnQDown_Click" Width="24" Height="16" Padding="0" Margin="4,4,0,0" Delay="300" Interval="80">▼</RepeatButton>
                        </StackPanel>
                    </Grid>
                    <Button Grid.Column="5" x:Name="BtnPlayPart" Click="BtnPlayPart_Click" Margin="8,0,0,0">Play Part</Button>
                    <!-- Spacer -->
                    <TextBlock Grid.Column="6"/>
                    <!-- Right: VOCA moved to below -->
                </Grid>

                <!-- Player -->
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblNow" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">00:00</TextBlock>
                        <Slider x:Name="SldPosition" Grid.Column="1" Minimum="0" ValueChanged="SldPosition_ValueChanged" PreviewMouseDown="SldPosition_PreviewMouseDown" PreviewMouseUp="SldPosition_PreviewMouseUp"/>
                        <TextBlock x:Name="LblTotal" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">00:00</TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Button x:Name="BtnSeekBack" Click="BtnSeekBack_Click" ToolTip="10초 뒤로">⏪</Button>
                        <Button x:Name="BtnPlay" Click="BtnPlay_Click">▶</Button>
                        <Button x:Name="BtnPause" Click="BtnPause_Click">⏸</Button>
                        <Button x:Name="BtnStop" Click="BtnStop_Click">⏹</Button>
                        <Button x:Name="BtnSeekForward" Click="BtnSeekForward_Click" ToolTip="10초 앞으로">⏩</Button>
                    </StackPanel>
                    <DockPanel Margin="0,8,0,0">
                        <ToggleButton x:Name="TglRepeat" DockPanel.Dock="Left" ToolTip="Repeat" Checked="TglRepeat_Checked" Unchecked="TglRepeat_Unchecked">🔁</ToggleButton>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="BtnPlayVocaLc" Click="BtnPlayVocaLc_Click">VOCA LC</Button>
                            <Button x:Name="BtnPlayVocaRc" Click="BtnPlayVocaRc_Click">VOCA RC</Button>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" Foreground="{StaticResource Brush.Muted}"/>
                    <TextBlock x:Name="TxtNowPlaying" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
