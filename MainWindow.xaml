<Window x:Class="ToeicAudioHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToeicAudioHelper"
        mc:Ignorable="d"
        Title="TOEIC Audio Helper"
        Height="520" Width="900"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True">
    <Border Style="{StaticResource Shell}" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Simple Top Bar -->
            <Border Grid.Row="0" Style="{StaticResource TopBar}" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="TOEIC Audio Helper" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="BtnMin" Click="BtnMin_Click" Width="22" Height="22" Margin="4,0">_</Button>
                        <Button x:Name="BtnMax" Click="BtnMax_Click" Width="22" Height="22" Margin="4,0">▢</Button>
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Width="22" Height="22" Margin="4,0">✕</Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <Button x:Name="BtnSelectFolder" Click="BtnSelectFolder_Click">Select Folder</Button>
                    <Button x:Name="BtnRescan" Click="BtnRescan_Click" Margin="6,0,0,0">Rescan</Button>
                    <TextBox x:Name="TxtRoot" IsReadOnly="True" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                </DockPanel>

                <!-- Controls Row -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Text="Test"/>
                    <ComboBox Grid.Column="1" x:Name="CmbTest" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="01"/>
                        <ComboBoxItem Content="02"/>
                        <ComboBoxItem Content="03"/>
                        <ComboBoxItem Content="04"/>
                        <ComboBoxItem Content="05"/>
                        <ComboBoxItem Content="06"/>
                        <ComboBoxItem Content="07"/>
                        <ComboBoxItem Content="08"/>
                        <ComboBoxItem Content="09"/>
                        <ComboBoxItem Content="10"/>
                    </ComboBox>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0" Text="Question"/>
                    <TextBox Grid.Column="4" x:Name="TxtQuestion" PreviewTextInput="TxtQuestion_PreviewTextInput" MaxLength="3" VerticalContentAlignment="Center"/>
                    <StackPanel Grid.Column="6" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnPlayAll" Click="BtnPlayAll_Click">Play All</Button>
                        <Button x:Name="BtnPlayPart" Click="BtnPlayPart_Click">Play Part</Button>
                        <Button x:Name="BtnPlayVocaLc" Click="BtnPlayVocaLc_Click">VOCA LC</Button>
                        <Button x:Name="BtnPlayVocaRc" Click="BtnPlayVocaRc_Click">VOCA RC</Button>
                    </StackPanel>
                </Grid>

                <!-- Player -->
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblNow" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">00:00</TextBlock>
                        <Slider x:Name="SldPosition" Grid.Column="1" Minimum="0" ValueChanged="SldPosition_ValueChanged" PreviewMouseDown="SldPosition_PreviewMouseDown" PreviewMouseUp="SldPosition_PreviewMouseUp"/>
                        <TextBlock x:Name="LblTotal" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">00:00</TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BtnPlay" Click="BtnPlay_Click">Play</Button>
                        <Button x:Name="BtnPause" Click="BtnPause_Click">Pause</Button>
                        <Button x:Name="BtnStop" Click="BtnStop_Click">Stop</Button>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatus" Margin="0,6,0,0" Foreground="{StaticResource Brush.Muted}"/>
                    <TextBlock x:Name="TxtNowPlaying" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

