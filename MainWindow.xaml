<Window x:Class="ToeicAudioHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToeicAudioHelper"
        mc:Ignorable="d"
        Title="TOEIC Audio Helper" Height="420" Width="880">
    <Grid Margin="10" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Folder selection -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <Button x:Name="BtnSelectFolder" Click="BtnSelectFolder_Click" Margin="0,0,8,0" Padding="12,4">폴더 선택</Button>
            <Button x:Name="BtnRescan" Click="BtnRescan_Click" Margin="0,0,8,0" Padding="12,4">재검색</Button>
            <TextBox x:Name="TxtRoot" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Controls line -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Text="Test:"/>
            <ComboBox Grid.Column="1" x:Name="CmbTest" SelectedIndex="0" VerticalAlignment="Center">
                <ComboBoxItem Content="01"/>
                <ComboBoxItem Content="02"/>
                <ComboBoxItem Content="03"/>
                <ComboBoxItem Content="04"/>
                <ComboBoxItem Content="05"/>
                <ComboBoxItem Content="06"/>
                <ComboBoxItem Content="07"/>
                <ComboBoxItem Content="08"/>
                <ComboBoxItem Content="09"/>
                <ComboBoxItem Content="10"/>
            </ComboBox>

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0" Text="문항:"/>
            <TextBox Grid.Column="4" x:Name="TxtQuestion" PreviewTextInput="TxtQuestion_PreviewTextInput" MaxLength="3" VerticalContentAlignment="Center"/>

            <Button Grid.Column="6" x:Name="BtnPlayAll" Click="BtnPlayAll_Click" Margin="12,0,0,0" Padding="12,4">전체 재생</Button>
            <Button Grid.Column="7" x:Name="BtnPlayPart" Click="BtnPlayPart_Click" Margin="6,0,0,0" Padding="12,4">부분 재생</Button>
            <Button Grid.Column="8" x:Name="BtnPlayVocaLc" Click="BtnPlayVocaLc_Click" Margin="12,0,0,0" Padding="12,4">VOCA LC</Button>
            <Button Grid.Column="9" x:Name="BtnPlayVocaRc" Click="BtnPlayVocaRc_Click" Margin="6,0,0,0" Padding="12,4">VOCA RC</Button>
        </Grid>

        <!-- Status only (compact) -->
        <TextBlock x:Name="TxtStatus" Grid.Row="2" Margin="0,0,0,8"/>

        <!-- Player controls (slider wide, buttons below) -->
        <StackPanel Grid.Row="3" Orientation="Vertical">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblNow" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">00:00</TextBlock>
                <Slider x:Name="SldPosition" Grid.Column="1" Margin="0" Minimum="0" ValueChanged="SldPosition_ValueChanged" PreviewMouseDown="SldPosition_PreviewMouseDown" PreviewMouseUp="SldPosition_PreviewMouseUp"/>
                <TextBlock x:Name="LblTotal" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">00:00</TextBlock>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="BtnPlay" Click="BtnPlay_Click" Padding="10,4">▶ 재생</Button>
                <Button x:Name="BtnPause" Click="BtnPause_Click" Margin="6,0,0,0" Padding="10,4">⏸ 일시정지</Button>
                <Button x:Name="BtnStop" Click="BtnStop_Click" Margin="6,0,0,0" Padding="10,4">⏹ 정지</Button>
            </StackPanel>
            <TextBlock x:Name="TxtNowPlaying" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
