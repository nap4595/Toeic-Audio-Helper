<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="GenerateAppIcon" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;New-Item -ItemType Directory -Force Assets | Out-Null; if (-not (Test-Path 'Assets\appicon.ico')) { $w=16;$h=16;$bytes=@(); $bytes += 0,0,1,0,1,0; $bytes += 16,16,0,0; $bytes += 1,0; $bytes += 32,0; $bytes += 0x68,0x04,0x00,0x00; $bytes += 0x16,0x00,0x00,0x00; $bytes += 40,0,0,0; $bytes += 16,0,0,0; $bytes += 32,0,0,0; $bytes += 1,0; $bytes += 32,0; $bytes += 0,0,0,0; $bytes += 0,4,0,0; $bytes += 0,0,0,0; $bytes += 0,0,0,0; $bytes += 0,0,0,0; $bytes += 0,0,0,0; for($i=0;$i -lt 256;$i++){ $bytes += 0xFF,0x90,0x1E,0xFF }; for($i=0;$i -lt 64;$i++){ $bytes += 0x00 }; [IO.File]::WriteAllBytes('Assets\appicon.ico', [byte[]]$bytes); } &quot;" />
  </Target>

  <ItemGroup>
    <None Include="README.txt">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="scripts\install-runtime.bat">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Include="scripts\runtime-installer-6.ps1">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UiKit.Wpf\UiKit.Wpf.csproj" />
  </ItemGroup>

</Project>
